# Production environment contract for the single-VPS Docker topology.
#
# Copy to .env.production on the VPS, fill in real values, and keep it out of
# git (.env* is already ignored). NOTHING in this file is a real credential.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Every value marked REQUIRED has no safe default. Compose refuses to start if
# one is missing rather than falling back to something insecure.

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED. The host is the compose service name; postgres is never published
# to the internet.
#
# IMPORTANT: packages/database/prisma.config.ts does NOT load dotenv. Prisma
# reads DATABASE_URL from the process environment only. The compose `migrate`
# service passes it explicitly, and any manual prisma command must too:
#   DATABASE_URL="postgresql://..." npx prisma migrate deploy --config packages/database/prisma.config.ts
DATABASE_URL=postgresql://ogun_app:replace-me@postgres:5432/ogun_production?schema=public
POSTGRES_DB=ogun_production
POSTGRES_USER=ogun_app
POSTGRES_PASSWORD=replace-me

# Only needed when reconciling a non-empty database that lacks the Ogun
# baseline marker. Must be a separate disposable database, never another schema
# in DATABASE_URL. Leave empty for normal deployments.
BASELINE_SHADOW_DATABASE_URL=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Carries BullMQ queues, the Socket.IO adapter, and transient presence.
# Never authoritative business truth: an empty Redis is a recoverable state.
REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=256mb

# Production realtime fails closed: if the adapter cannot connect, the API
# exits rather than silently serving single-instance delivery.
REALTIME_REDIS_REQUIRED=true
REALTIME_PATH=/socket.io
REALTIME_CONNECTION_STATE_RECOVERY_MS=120000
REALTIME_PRESENCE_TTL_SECONDS=90

# ─── Authentication ──────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-securely-generated-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=ogun-election-operations-api
JWT_AUDIENCE=ogun-election-operations-web
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=20

# ─── Application / proxy ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_JSON_BODY_LIMIT=1mb

# Exactly one proxy hop (Caddy) sits in front of the API. Setting this higher
# than the real hop count lets a client spoof its source IP through
# X-Forwarded-For and defeat rate limiting.
TRUST_PROXY_HOPS=1

# REQUIRED. Comma-separated exact origins. No wildcards in production.
CORS_ALLOWED_ORIGINS=https://ops.example.org

# ─── Edge / TLS ──────────────────────────────────────────────────────────────
# REQUIRED. The public hostname Caddy serves and obtains a certificate for.
# DNS must already resolve to this VPS before first start.
SITE_ADDRESS=ops.example.org
# REQUIRED. Used for Let's Encrypt expiry notices.
TLS_CONTACT_EMAIL=ops@example.org
MAX_REQUEST_BODY=12MB

# ─── Web (compiled into the browser bundle at build time) ────────────────────
# Public endpoint URLs, not secrets. Caddy strips the /api prefix before
# proxying to Express, whose routes are mounted at the root.
NEXT_PUBLIC_API_BASE_URL=https://ops.example.org/api
NEXT_PUBLIC_REALTIME_URL=https://ops.example.org
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Evidence object storage ─────────────────────────────────────────────────
# REQUIRED in production. Authoritative evidence and voter documents live in a
# private S3-compatible service, never on a container filesystem or volume.
# The API refuses to start in production with any driver other than s3.
#
# The bucket must be private (no public read), versioned, and ideally
# Object-Lock capable. Provision it before first deploy; nothing in this
# repository creates it.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://s3.eu-central-1.example-provider.com
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=ogun-election-evidence
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
# Most self-hosted and non-AWS providers require path-style addressing.
STORAGE_FORCE_PATH_STYLE=true

# ─── WebRTC / Coturn ─────────────────────────────────────────────────────────
# STUN alone is not enough for field devices behind carrier-grade NAT.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# REQUIRED for voice in production. TURN_URL must be a turn:/turns: URI; the
# API rejects anything else rather than reporting TURN as configured.
TURN_URL=turn:ops.example.org:3478
TURN_USERNAME=replace-me
TURN_CREDENTIAL=replace-me

# Coturn container settings. TURN_EXTERNAL_IP must be the VPS public address,
# otherwise every relayed candidate is unreachable.
TURN_REALM=ops.example.org
TURN_EXTERNAL_IP=203.0.113.10
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# TURN TLS is opt-in and off by default. Leave both cert variables empty and the
# TLS/DTLS listeners are explicitly disabled; set both and turns: is enabled on
# TURN_TLS_PORT. Setting only one, or pointing at an unreadable file, makes the
# container refuse to start rather than advertise a TLS endpoint that cannot
# complete a handshake.
#
# Media confidentiality does not depend on this: WebRTC is already end-to-end
# encrypted with DTLS-SRTP. TURN TLS buys traversal of firewalls that only
# permit 443. See docs/DEPLOYMENT_VPS.md §4a.
TURN_TLS_PORT=5349
TURN_TLS_CERT=
TURN_TLS_KEY=

# ─── Worker / queues ─────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=4100
# How often durable PENDING jobs are swept from PostgreSQL into BullMQ.
WORKER_POLL_INTERVAL_MS=5000
# A job left PROCESSING beyond this age is treated as abandoned and retried.
WORKER_STALE_PROCESSING_MINUTES=15
WORKER_MAX_ATTEMPTS=5
WORKER_OUTBOX_BATCH_SIZE=100

# ─── Resource ceilings (single VPS) ──────────────────────────────────────────
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=384m
API_MEMORY_LIMIT=768m
WORKER_MEMORY_LIMIT=768m
WEB_MEMORY_LIMIT=512m

# ─── Bootstrap (first deploy only) ───────────────────────────────────────────
# Used by the one-off bootstrap command documented in docs/DEPLOYMENT_VPS.md.
# Routine container restarts never read these, and nothing auto-seeds.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Ogun Platform Super Admin

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Image tag ───────────────────────────────────────────────────────────────
# Pin to a release tag for reproducible rollback.
IMAGE_TAG=latest
