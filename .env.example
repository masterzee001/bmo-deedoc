# DATABASE - currently implemented with PostgreSQL
DATABASE_URL=postgresql://ogun_app:replace-local-password@127.0.0.1:55432/ogun_development?schema=public
OGUN_POSTGRES_PORT=55432
# Required only while reconciling a non-empty database without the Ogun baseline marker.
# This must identify a separate disposable database, never another schema in DATABASE_URL.
BASELINE_SHADOW_DATABASE_URL=

# AUTH - currently implemented
# Production JWT_SECRET must be generated securely and contain at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=ogun-election-operations-api
JWT_AUDIENCE=ogun-election-operations-web
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=20

# APPLICATION - currently implemented
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
API_JSON_BODY_LIMIT=1mb
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# CORS - currently implemented; comma-separated exact origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# BOOTSTRAP - optional outside production; never commit real credentials
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Ogun Platform Super Admin

# REDIS - TARGET/RESERVED; no Redis client is implemented in Phase 0
REDIS_URL=

# STORAGE - TARGET/RESERVED; private object storage is not implemented in Phase 0
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# REALTIME - TARGET/RESERVED; Socket.IO services are not implemented in Phase 0
NEXT_PUBLIC_REALTIME_URL=
REALTIME_ALLOWED_ORIGINS=

# WEBRTC - TARGET/RESERVED; signalling and TURN are not implemented in Phase 0
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# OBSERVABILITY - TARGET/RESERVED; provider integration is not implemented in Phase 0
LOG_LEVEL=info
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
