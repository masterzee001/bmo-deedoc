model ReferenceDataImportRelease {
  id                            String                    @id @default(cuid())
  releaseId                     String                    @unique
  kind                          ReferenceDataImportKind
  stateId                       String
  sourcePublisher               String
  sourceUrl                     String?
  sourceDocumentId              String?
