  updatedAt          DateTime               @updatedAt
  createdByUser      User                   @relation("RewardRuleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions           RewardRuleVersion[]

  @@index([qualifyingEvent, active])
  @@index([eligibleRole])
  @@index([createdByUserId])
}

model RewardRuleVersion {
  id                   String              @id @default(cuid())
  rewardRuleId         String
  version              Int
  directPoints         Int
  upstreamPointsConfig Json?
  maximumPoints        Int?
  effectiveFrom        DateTime            @default(now())
  createdAt            DateTime            @default(now())
  rewardRule           RewardRule          @relation(fields: [rewardRuleId], references: [id], onDelete: Restrict)
  rewardEvents         RewardEvent[]
  ledgerEntries        RewardLedgerEntry[]

  @@unique([rewardRuleId, version])
  @@index([rewardRuleId, effectiveFrom])
}

model RewardEvent {
  id                  String                @id @default(cuid())
  eventType           RewardQualifyingEvent
  sourceType          String
  sourceId            String
  referralId          String?
  rewardRuleVersionId String?
  status              RewardEventStatus     @default(PENDING)
