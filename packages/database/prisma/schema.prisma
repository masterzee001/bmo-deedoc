generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CANDIDATE
  AGENT
  VOTER
}

enum AdminLevel {
  NATIONAL
  GEO_POLITICAL_ZONE
  STATE
  SENATORIAL
  FEDERAL_CONSTITUENCY
  STATE_CONSTITUENCY
  LGA
  WARD
}

enum CandidateOfficeType {
  PRESIDENTIAL
  GOVERNORSHIP
  SENATE
  HOUSE_OF_REP
  STATE_ASSEMBLY
  CHAIRMANSHIP
  COUNCILLOR
}

enum RewardType {
  PARTICIPATION
  REFERRAL
  BONUS
  MANUAL_ADJUSTMENT
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum AssignmentPermissionType {
  VIEW
  MANAGE
  PUBLISH
  MODERATE
}

enum AgentActivityType {
  CHECK_IN
  CHECK_OUT
  LOCATION_PING
  INCIDENT_RESPONSE
  VOTER_OUTREACH
  MATERIAL_DISTRIBUTION
  OBSERVATION
}

enum IncidentType {
  VIOLENCE
  INTIMIDATION
  VOTE_BUYING
  MATERIAL_SHORTAGE
  LOGISTICS_DELAY
  MALFUNCTION
  SECURITY_CONCERN
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  REWARD_EARNED
  REWARD_REDEMPTION
  INCIDENT_ASSIGNED
  INCIDENT_UPDATED
  POLL_CREATED
  POST_PUBLISHED
  SYSTEM
}

enum FieldTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum FieldTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BroadcastAudience {
  ALL
  ADMINS
  AGENTS
  VOTERS
  CANDIDATES
}

enum CampaignMediaType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

enum CampaignEventRsvpStatus {
  INTERESTED
  GOING
}

enum CandidateMediaAssetKind {
  PROFILE_PHOTO
  EVENT_COVER
}

enum ElectionDayOpeningStatus {
  OPENED_ON_TIME
  OPENED_LATE
  NOT_OPEN
}

enum ElectionDayReportStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ElectionDayReportAssetKind {
  ARRIVAL_PHOTO
  POST_COUNTING_PHOTO
}

model User {
  id                     String                     @id @default(cuid())
  name                   String
  email                  String                     @unique
  phone                  String?
  passwordHash           String
  role                   UserRole
  isActive               Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  adminProfile           AdminProfile?
  candidateProfile       CandidateProfile?
  agentProfile           AgentProfile?
  voterProfile           VoterProfile?
  managedCandidateLinks  AdminCandidateAssignment[] @relation("AssignmentAdmin")
  assignedAdminLinks     AdminCandidateAssignment[] @relation("AssignmentCandidate")
  rewardEntries          RewardLedger[]             @relation("RewardOwner")
  rewardRelatedEntries   RewardLedger[]             @relation("RewardRelatedUser")
  rewardRedemptions      RewardRedemption[]         @relation("RewardRedemptionVoter")
  reviewedRedemptions    RewardRedemption[]         @relation("RewardRedemptionReviewer")
  referralsMade          VoterProfile[]             @relation("VoterReferral")
  assignedAgents         AgentProfile[]             @relation("AssignedAdmin")
  participationEvents    ParticipationEvent[]
  createdPolls           Poll[]                     @relation("PollCreator")
  candidatePolls         Poll[]                     @relation("PollCandidate")
  pollResponses          PollResponse[]
  authoredPosts          Post[]                     @relation("PostAuthor")
  candidatePosts         Post[]                     @relation("PostCandidate")
  voterFeedbackItems     Feedback[]                 @relation("FeedbackVoter")
  agentFeedbackItems     Feedback[]                 @relation("FeedbackAgent")
  candidateFeedbackItems Feedback[]                 @relation("FeedbackCandidate")
  agentActivities        AgentActivity[]
  reportedIncidents      Incident[]                 @relation("IncidentReporter")
  assignedIncidents      Incident[]                 @relation("IncidentAssignedAdmin")
  escalatedIncidents     Incident[]                 @relation("IncidentEscalatedBy")
  assignedTasks          FieldTask[]                @relation("FieldTaskAssignee")
  createdTasks           FieldTask[]                @relation("FieldTaskCreator")
  createdBroadcasts      BroadcastMessage[]         @relation("BroadcastCreator")
  notifications          Notification[]
  auditLogs              AuditLog[]
  mediaAttachments       MediaAttachment[]          @relation("MediaUploader")
  createdEngagementTasks VoterEngagementTask[]      @relation("EngagementTaskCreator")
  engagementTaskClaims   VoterEngagementClaim[]
  createdCampaignEvents  CampaignEvent[]            @relation("CampaignEventCreator")
  candidateCampaignEvents CampaignEvent[]           @relation("CampaignEventCandidate")
  campaignEventRsvps     CampaignEventRsvp[]
  candidateMediaAssets   CandidateMediaAsset[]      @relation("CandidateMediaOwner")
  electionDayReports     ElectionDayReport[]        @relation("ElectionDayReportAgent")
  reviewedElectionDayReports ElectionDayReport[]    @relation("ElectionDayReportReviewer")
  electionDayReportAssets ElectionDayReportAsset[]  @relation("ElectionDayReportAssetOwner")

  @@index([role])
  @@index([isActive])
}

model AdminProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  adminLevel            AdminLevel
  politicalPartyId      String?
  geoPoliticalZoneId    String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  politicalParty        PoliticalParty?      @relation(fields: [politicalPartyId], references: [id])
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])

  @@index([adminLevel])
  @@index([politicalPartyId])
  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model CandidateProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  officeType            CandidateOfficeType
  geoPoliticalZoneId    String?
  politicalPartyId      String?
  portraitUrl           String?
  portraitAssetId       String?
  campaignSlogan        String?
  bio                   String?
  websiteUrl            String?
  facebookUrl           String?
  instagramUrl          String?
  xUrl                  String?
  isProfilePublished    Boolean              @default(false)
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  politicalParty        PoliticalParty?      @relation(fields: [politicalPartyId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])
  portraitAsset         CandidateMediaAsset? @relation("CandidateProfilePortraitAsset", fields: [portraitAssetId], references: [id], onDelete: SetNull)

  @@index([officeType])
  @@index([geoPoliticalZoneId])
  @@index([politicalPartyId])
  @@index([portraitAssetId])
  @@index([isProfilePublished])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model AgentProfile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  assignedAdminUserId String?
  politicalPartyId    String?
  gpsTrackingConsentAt DateTime?
  activeSessionNonce  String?
  geoPoliticalZoneId  String?
  stateId             String
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId               String
  wardId              String
  stateConstituencyId String?
  pollingUnitId       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAdminUser   User?        @relation("AssignedAdmin", fields: [assignedAdminUserId], references: [id])
  politicalParty      PoliticalParty? @relation(fields: [politicalPartyId], references: [id])
  geoPoliticalZone    GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state               State        @relation(fields: [stateId], references: [id])
  senatorialDistrict  SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                 LGA          @relation(fields: [lgaId], references: [id])
  ward                Ward         @relation(fields: [wardId], references: [id])
  stateConstituency   StateConstituency? @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit         PollingUnit? @relation(fields: [pollingUnitId], references: [id])

  @@index([geoPoliticalZoneId])
  @@index([assignedAdminUserId])
  @@index([politicalPartyId])
  @@index([activeSessionNonce])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model VoterProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  voterCardNumber  String   @unique
  referralCode     String   @unique
  referredByUserId String?
  contactConsent   Boolean  @default(false)
  termsAcceptedAt  DateTime?
  geoPoliticalZoneId String?
  stateId          String
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId            String
  wardId           String
  stateConstituencyId String?
  pollingUnitId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredByUser   User?    @relation("VoterReferral", fields: [referredByUserId], references: [id])
  geoPoliticalZone GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state            State    @relation(fields: [stateId], references: [id])
  senatorialDistrict SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga              LGA      @relation(fields: [lgaId], references: [id])
  ward             Ward     @relation(fields: [wardId], references: [id])
  stateConstituency StateConstituency? @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit      PollingUnit? @relation(fields: [pollingUnitId], references: [id])

  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
  @@index([referredByUserId])
}

model VoterEngagementTask {
  id                   String                 @id @default(cuid())
  title                String
  description          String
  type                 String
  rewardPoints         Int
  targetCount          Int?
  isActive             Boolean                @default(true)
  createdByUserId      String
  geoPoliticalZoneId   String?
  stateId              String?
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId                String?
  wardId               String?
  stateConstituencyId  String?
  pollingUnitId        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdByUser        User                   @relation("EngagementTaskCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone     GeoPoliticalZone?      @relation(fields: [geoPoliticalZoneId], references: [id])
  state                State?                 @relation(fields: [stateId], references: [id])
  senatorialDistrict   SenatorialDistrict?    @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency  FederalConstituency?   @relation(fields: [federalConstituencyId], references: [id])
  lga                  LGA?                   @relation(fields: [lgaId], references: [id])
  ward                 Ward?                  @relation(fields: [wardId], references: [id])
  stateConstituency    StateConstituency?     @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit          PollingUnit?           @relation(fields: [pollingUnitId], references: [id])
  claims               VoterEngagementClaim[]

  @@index([createdByUserId])
  @@index([isActive])
  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
}

model VoterEngagementClaim {
  id               String              @id @default(cuid())
  taskId           String
  voterUserId      String
  progressCount    Int                 @default(0)
  claimedAt        DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  task             VoterEngagementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  voterUser        User                @relation(fields: [voterUserId], references: [id], onDelete: Cascade)

  @@unique([taskId, voterUserId])
  @@index([voterUserId])
}

model AdminCandidateAssignment {
  id              String                   @id @default(cuid())
  adminUserId     String
  candidateUserId String
  permissionType  AssignmentPermissionType
  createdAt       DateTime                 @default(now())
  adminUser       User                     @relation("AssignmentAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  candidateUser   User                     @relation("AssignmentCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, candidateUserId, permissionType])
  @@index([candidateUserId])
  @@index([permissionType])
}

model RewardLedger {
  id            String   @id @default(cuid())
  voterUserId   String
  type          RewardType
  points        Int
  amount        Float?
  description   String
  relatedUserId String?
  createdAt     DateTime @default(now())
  voterUser     User     @relation("RewardOwner", fields: [voterUserId], references: [id], onDelete: Cascade)
  relatedUser   User?    @relation("RewardRelatedUser", fields: [relatedUserId], references: [id])

  @@index([voterUserId, createdAt])
  @@index([type])
  @@unique([voterUserId, type, relatedUserId])
}

model ParticipationEvent {
  id           String   @id @default(cuid())
  voterUserId   String
  type          String
  description   String
  pointsAwarded Int
  relatedPollId String?
  relatedPostId String?
  createdAt     DateTime @default(now())
  voterUser     User     @relation(fields: [voterUserId], references: [id], onDelete: Cascade)
  relatedPoll   Poll?    @relation(fields: [relatedPollId], references: [id])
  relatedPost   Post?    @relation(fields: [relatedPostId], references: [id])

  @@index([voterUserId, createdAt])
  @@index([type])
  @@index([relatedPollId])
  @@index([relatedPostId])
}

model CampaignEvent {
  id                    String                   @id @default(cuid())
  candidateUserId       String
  createdByUserId       String
  title                 String
  description           String
  venue                 String
  coverImageUrl         String?
  coverImageAssetId     String?
  registrationUrl       String?
  startsAt              DateTime
  endsAt                DateTime?
  isPublished           Boolean                  @default(false)
  geoPoliticalZoneId    String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  candidateUser         User                     @relation("CampaignEventCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  createdByUser         User                     @relation("CampaignEventCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone      GeoPoliticalZone?        @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?                   @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?      @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency?     @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                     @relation(fields: [lgaId], references: [id])
  ward                  Ward?                    @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?       @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?             @relation(fields: [pollingUnitId], references: [id])
  coverImageAsset       CandidateMediaAsset?     @relation("CampaignEventCoverAsset", fields: [coverImageAssetId], references: [id], onDelete: SetNull)
  rsvps                 CampaignEventRsvp[]

  @@index([candidateUserId])
  @@index([createdByUserId])
  @@index([isPublished])
  @@index([startsAt])
  @@index([coverImageAssetId])
  @@index([stateId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
}

model CampaignEventRsvp {
  id          String                  @id @default(cuid())
  eventId      String
  voterUserId String
  status      CampaignEventRsvpStatus @default(GOING)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  event       CampaignEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voterUser   User                    @relation(fields: [voterUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, voterUserId])
  @@index([voterUserId])
  @@index([status])
}

model CandidateMediaAsset {
  id               String                  @id @default(cuid())
  ownerUserId      String
  kind             CandidateMediaAssetKind
  fileName         String
  mimeType         String
  data             Bytes
  sizeBytes        Int
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  ownerUser        User                    @relation("CandidateMediaOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  portraitProfiles CandidateProfile[]      @relation("CandidateProfilePortraitAsset")
  coverEvents      CampaignEvent[]         @relation("CampaignEventCoverAsset")

  @@index([ownerUserId])
  @@index([kind])
}

model Poll {
  id                    String               @id @default(cuid())
  title                 String
  description           String?
  candidateUserId       String?
  officeType            CandidateOfficeType?
  geoPoliticalZoneId    String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdByUserId       String
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  candidateUser         User?                @relation("PollCandidate", fields: [candidateUserId], references: [id])
  createdByUser         User                 @relation("PollCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])
  options               PollOption[]
  responses             PollResponse[]
  participationEvents   ParticipationEvent[]

  @@index([geoPoliticalZoneId])
  @@index([candidateUserId])
  @@index([officeType])
  @@index([isActive])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model PollOption {
  id        String   @id @default(cuid())
  pollId     String
  label      String
  createdAt  DateTime @default(now())
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses  PollResponse[]

  @@unique([pollId, label])
  @@index([pollId])
}

model PollResponse {
  id          String     @id @default(cuid())
  pollId      String
  voterUserId String
  optionId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voterUser   User       @relation(fields: [voterUserId], references: [id], onDelete: Cascade)
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterUserId])
  @@index([optionId])
}

model Post {
  id                    String               @id @default(cuid())
  authorUserId          String
  candidateUserId       String?
  geoPoliticalZoneId    String?
  title                 String
  content               String
  mediaType             CampaignMediaType    @default(TEXT)
  mediaUrl              String?
  thumbnailUrl          String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  isPublished           Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  authorUser            User                 @relation("PostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  candidateUser         User?                @relation("PostCandidate", fields: [candidateUserId], references: [id])
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])
  participationEvents   ParticipationEvent[]

  @@index([geoPoliticalZoneId])
  @@index([authorUserId])
  @@index([candidateUserId])
  @@index([isPublished])
  @@index([mediaType])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model Feedback {
  id                   String               @id @default(cuid())
  voterUserId          String?
  agentUserId          String?
  candidateUserId      String?
  type                 String
  message              String
  geoPoliticalZoneId   String?
  stateId              String
  senatorialDistrictId String?
  lgaId                String
  wardId               String?
  pollingUnitId        String?
  createdAt            DateTime             @default(now())
  voterUser            User?                @relation("FeedbackVoter", fields: [voterUserId], references: [id])
  agentUser            User?                @relation("FeedbackAgent", fields: [agentUserId], references: [id])
  candidateUser        User?                @relation("FeedbackCandidate", fields: [candidateUserId], references: [id])
  geoPoliticalZone     GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                State                @relation(fields: [stateId], references: [id])
  senatorialDistrict   SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  lga                  LGA                  @relation(fields: [lgaId], references: [id])
  ward                 Ward?                @relation(fields: [wardId], references: [id])
  pollingUnit          PollingUnit?         @relation(fields: [pollingUnitId], references: [id])
