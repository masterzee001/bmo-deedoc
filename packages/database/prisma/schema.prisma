  sourceEvent         RewardEvent           @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  rewardRuleVersion   RewardRuleVersion?    @relation(fields: [rewardRuleVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceEventId, category])
  @@index([userId, createdAt])
  @@index([category])
  @@index([rewardRuleVersionId])
  @@index([relatedUserId])
}

model PayoutConfiguration {
