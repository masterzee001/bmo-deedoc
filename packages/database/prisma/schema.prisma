generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  STATE_OFFICER
  COORDINATOR
  VALIDATOR
  PAYOUT_OFFICER
  MEMBER
  // Legacy compatibility values. Phase 1 migration maps eligible Ogun users.
  ADMIN
  CANDIDATE
  AGENT
  VOTER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CoordinatorLevel {
  SENATORIAL_DISTRICT
  FEDERAL_CONSTITUENCY
  STATE_CONSTITUENCY
  WARD
  POLLING_UNIT
}

enum ReferenceDataImportKind {
  OGUN_IDENTITY
  OGUN_POLLING_UNIT_GEODATA
}

enum ReferenceDataImportStatus {
  STAGED
  APPLIED
  REJECTED
}

enum AdminLevel {
  NATIONAL
  GEO_POLITICAL_ZONE
  STATE
  SENATORIAL
  FEDERAL_CONSTITUENCY
  STATE_CONSTITUENCY
  LGA
  WARD
}

enum CandidateOfficeType {
  PRESIDENTIAL
  GOVERNORSHIP
  SENATE
  HOUSE_OF_REP
  STATE_ASSEMBLY
  CHAIRMANSHIP
  COUNCILLOR
}

enum RewardType {
  PARTICIPATION
  REFERRAL
  BONUS
  MANUAL_ADJUSTMENT
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum AssignmentPermissionType {
  VIEW
  MANAGE
  PUBLISH
  MODERATE
}

enum AgentActivityType {
  CHECK_IN
  CHECK_OUT
  LOCATION_PING
  INCIDENT_RESPONSE
  VOTER_OUTREACH
  MATERIAL_DISTRIBUTION
  OBSERVATION
}

enum IncidentType {
  VIOLENCE
  INTIMIDATION
  VOTE_BUYING
  MATERIAL_SHORTAGE
  LOGISTICS_DELAY
  MALFUNCTION
  SECURITY_CONCERN
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  REWARD_EARNED
  REWARD_REDEMPTION
  INCIDENT_ASSIGNED
  INCIDENT_UPDATED
  POLL_CREATED
  POST_PUBLISHED
  SYSTEM
}

enum FieldTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum FieldTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BroadcastAudience {
  ALL
  ADMINS
  AGENTS
  VOTERS
  CANDIDATES
}

enum CampaignMediaType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

enum CampaignEventRsvpStatus {
  INTERESTED
  GOING
}

enum CandidateMediaAssetKind {
  PROFILE_PHOTO
  EVENT_COVER
}

enum ElectionDayOpeningStatus {
  OPENED_ON_TIME
  OPENED_LATE
  NOT_OPEN
}

enum ElectionDayReportStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ElectionDayReportAssetKind {
  ARRIVAL_PHOTO
  POST_COUNTING_PHOTO
}

enum VoterVerificationStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  RESUBMISSION_REQUIRED
  VERIFIED
  REJECTED
}

enum VoterVerificationDecision {
  SUBMITTED
  CLAIMED
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  FLAGGED
  NOTE_ADDED
}

enum ReferralStatus {
  REGISTERED
  PENDING_VERIFICATION
  QUALIFIED
  REJECTED
  FLAGGED
  REWARD_PROCESSED
}

enum RewardQualifyingEvent {
  VOTER_VERIFICATION_APPROVED
}

enum RewardLedgerCategory {
  VERIFIED_REFERRAL
  FIELD_ACTIVITY
  TASK_COMPLETION
  APPROVED_PARTICIPATION
  BONUS
  MANUAL_ADJUSTMENT
}

enum RewardEventStatus {
  PENDING
  PROCESSED
  SKIPPED
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  APPROVED
  PROCESSING
  PAID
  HELD
  REJECTED
}

model User {
  id                         String                     @id @default(cuid())
  name                       String
  email                      String                     @unique
  phone                      String?
  passwordHash               String
  role                       UserRole
  isActive                   Boolean                    @default(true)
  accountStatus              AccountStatus              @default(ACTIVE)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  adminProfile               AdminProfile?
  candidateProfile           CandidateProfile?
  agentProfile               AgentProfile?
  voterProfile               VoterProfile?
  coordinatorProfile         CoordinatorProfile?
  legacyCandidateDomain      Candidate?                 @relation("LegacyCandidateUser")
  managedCandidateLinks      AdminCandidateAssignment[] @relation("AssignmentAdmin")
  assignedAdminLinks         AdminCandidateAssignment[] @relation("AssignmentCandidate")
  rewardEntries              RewardLedger[]             @relation("RewardOwner")
  rewardRelatedEntries       RewardLedger[]             @relation("RewardRelatedUser")
  rewardRedemptions          RewardRedemption[]         @relation("RewardRedemptionVoter")
  reviewedRedemptions        RewardRedemption[]         @relation("RewardRedemptionReviewer")
  referralsMade              VoterProfile[]             @relation("VoterReferral")
  assignedAgents             AgentProfile[]             @relation("AssignedAdmin")
  participationEvents        ParticipationEvent[]
  createdPolls               Poll[]                     @relation("PollCreator")
  candidatePolls             Poll[]                     @relation("PollCandidate")
  pollResponses              PollResponse[]
  authoredPosts              Post[]                     @relation("PostAuthor")
  candidatePosts             Post[]                     @relation("PostCandidate")
  voterFeedbackItems         Feedback[]                 @relation("FeedbackVoter")
  agentFeedbackItems         Feedback[]                 @relation("FeedbackAgent")
  candidateFeedbackItems     Feedback[]                 @relation("FeedbackCandidate")
  agentActivities            AgentActivity[]
  reportedIncidents          Incident[]                 @relation("IncidentReporter")
  assignedIncidents          Incident[]                 @relation("IncidentAssignedAdmin")
  escalatedIncidents         Incident[]                 @relation("IncidentEscalatedBy")
  assignedTasks              FieldTask[]                @relation("FieldTaskAssignee")
  createdTasks               FieldTask[]                @relation("FieldTaskCreator")
  createdBroadcasts          BroadcastMessage[]         @relation("BroadcastCreator")
  notifications              Notification[]
  auditLogs                  AuditLog[]
  mediaAttachments           MediaAttachment[]          @relation("MediaUploader")
  createdEngagementTasks     VoterEngagementTask[]      @relation("EngagementTaskCreator")
  engagementTaskClaims       VoterEngagementClaim[]
  createdCampaignEvents      CampaignEvent[]            @relation("CampaignEventCreator")
  candidateCampaignEvents    CampaignEvent[]            @relation("CampaignEventCandidate")
  campaignEventRsvps         CampaignEventRsvp[]
  candidateMediaAssets       CandidateMediaAsset[]      @relation("CandidateMediaOwner")
  electionDayReports         ElectionDayReport[]        @relation("ElectionDayReportAgent")
  reviewedElectionDayReports ElectionDayReport[]        @relation("ElectionDayReportReviewer")
  electionDayReportAssets    ElectionDayReportAsset[]   @relation("ElectionDayReportAssetOwner")
  voterVerifications         VoterVerification[]        @relation("VoterVerificationMember")
  reviewedVerifications      VoterVerification[]        @relation("VoterVerificationReviewer")
  verificationHistoryActions VoterVerificationHistory[] @relation("VoterVerificationHistoryActor")
  referralCodes              ReferralCode[]             @relation("ReferralCodeOwner")
  referralsOwned             Referral[]                 @relation("ReferralReferrerUser")
  referralsReceived          Referral[]                 @relation("ReferralReferredUser")
  createdRewardRules         RewardRule[]               @relation("RewardRuleCreator")
  rewardLedgerEntries        RewardLedgerEntry[]        @relation("RewardLedgerEntryUser")
  relatedRewardLedgerEntries RewardLedgerEntry[]        @relation("RewardLedgerEntryRelatedUser")
  payoutConfigurations       PayoutConfiguration[]      @relation("PayoutConfigurationCreator")
  payoutOfficerAssignments   PayoutAssignment[]         @relation("PayoutAssignmentOfficer")
  payoutBeneficiaryItems     PayoutAssignment[]         @relation("PayoutAssignmentBeneficiary")
  payoutTransactions         PayoutTransaction[]        @relation("PayoutTransactionOfficer")
  strengthMetricsCreated     StrengthMetricDefinition[] @relation("StrengthMetricCreator")
  strengthWeightsCreated     StrengthWeightConfiguration[] @relation("StrengthWeightCreator")
  campaignTargetsCreated     TerritoryTarget[]          @relation("TerritoryTargetCreator")

  @@index([role])
  @@index([isActive])
  @@index([accountStatus])
}

model CoordinatorProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  level                 CoordinatorLevel
  stateId               String
  senatorialDistrictId  String?
  federalConstituencyId String?
  stateConstituencyId   String?
  wardId                String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  state                 State                @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])

  @@index([level])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([stateConstituencyId])
  @@index([wardId])
  @@index([pollingUnitId])
}

model Candidate {
  id                    String                     @id @default(cuid())
  legacyUserId          String?                    @unique
  fullName              String
  officeType            CandidateOfficeType
  politicalPartyId      String?
  portraitUrl           String?
  portraitAssetId       String?
  campaignSlogan        String?
  bio                   String?
  websiteUrl            String?
  facebookUrl           String?
  instagramUrl          String?
  xUrl                  String?
  isPublished           Boolean                    @default(false)
  isActive              Boolean                    @default(true)
  stateId               String
  senatorialDistrictId  String?
  federalConstituencyId String?
  stateConstituencyId   String?
  lgaId                 String?
  wardId                String?
  pollingUnitId         String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  legacyUser            User?                      @relation("LegacyCandidateUser", fields: [legacyUserId], references: [id], onDelete: SetNull)
  politicalParty        PoliticalParty?            @relation(fields: [politicalPartyId], references: [id])
  portraitAsset         CandidateMediaAsset?       @relation("CandidateDomainPortraitAsset", fields: [portraitAssetId], references: [id], onDelete: SetNull)
  state                 State                      @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?        @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency?       @relation(fields: [federalConstituencyId], references: [id])
  stateConstituency     StateConstituency?         @relation(fields: [stateConstituencyId], references: [id])
  lga                   LGA?                       @relation(fields: [lgaId], references: [id])
  ward                  Ward?                      @relation(fields: [wardId], references: [id])
  pollingUnit           PollingUnit?               @relation(fields: [pollingUnitId], references: [id])
  adminAssignments      AdminCandidateAssignment[]
  campaignEvents        CampaignEvent[]
  polls                 Poll[]
  posts                 Post[]
  feedbackItems         Feedback[]

  @@index([officeType])
  @@index([politicalPartyId])
  @@index([portraitAssetId])
  @@index([isPublished])
  @@index([isActive])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([stateConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
}

model AdminProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  adminLevel            AdminLevel
  politicalPartyId      String?
  geoPoliticalZoneId    String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  politicalParty        PoliticalParty?      @relation(fields: [politicalPartyId], references: [id])
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])

  @@index([adminLevel])
  @@index([politicalPartyId])
  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model CandidateProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  officeType            CandidateOfficeType
  geoPoliticalZoneId    String?
  politicalPartyId      String?
  portraitUrl           String?
  portraitAssetId       String?
  campaignSlogan        String?
  bio                   String?
  websiteUrl            String?
  facebookUrl           String?
  instagramUrl          String?
  xUrl                  String?
  isProfilePublished    Boolean              @default(false)
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  politicalParty        PoliticalParty?      @relation(fields: [politicalPartyId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])
  portraitAsset         CandidateMediaAsset? @relation("CandidateProfilePortraitAsset", fields: [portraitAssetId], references: [id], onDelete: SetNull)

  @@index([officeType])
  @@index([geoPoliticalZoneId])
  @@index([politicalPartyId])
  @@index([portraitAssetId])
  @@index([isProfilePublished])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model AgentProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  assignedAdminUserId   String?
  politicalPartyId      String?
  gpsTrackingConsentAt  DateTime?
  activeSessionNonce    String?
  geoPoliticalZoneId    String?
  stateId               String
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String
  wardId                String
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAdminUser     User?                @relation("AssignedAdmin", fields: [assignedAdminUserId], references: [id])
  politicalParty        PoliticalParty?      @relation(fields: [politicalPartyId], references: [id])
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State                @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA                  @relation(fields: [lgaId], references: [id])
  ward                  Ward                 @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])

  @@index([geoPoliticalZoneId])
  @@index([assignedAdminUserId])
  @@index([politicalPartyId])
  @@index([activeSessionNonce])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model VoterProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  voterCardNumber       String               @unique
  referralCode          String               @unique
  referredByUserId      String?
  contactConsent        Boolean              @default(false)
  termsAcceptedAt       DateTime?
  privacyAcceptedAt     DateTime?
  documentConsentAt     DateTime?
  consentVersion        String?
  geoPoliticalZoneId    String?
  stateId               String
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String
  wardId                String
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredByUser        User?                @relation("VoterReferral", fields: [referredByUserId], references: [id])
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State                @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA                  @relation(fields: [lgaId], references: [id])
  ward                  Ward                 @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])

  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
  @@index([referredByUserId])
}

model VoterEngagementTask {
  id                    String                 @id @default(cuid())
  title                 String
  description           String
  type                  String
  rewardPoints          Int
  targetCount           Int?
  isActive              Boolean                @default(true)
  createdByUserId       String
  geoPoliticalZoneId    String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdByUser         User                   @relation("EngagementTaskCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone      GeoPoliticalZone?      @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?                 @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?    @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency?   @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                   @relation(fields: [lgaId], references: [id])
  ward                  Ward?                  @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?     @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?           @relation(fields: [pollingUnitId], references: [id])
  claims                VoterEngagementClaim[]

  @@index([createdByUserId])
  @@index([isActive])
  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
}

model VoterEngagementClaim {
  id            String              @id @default(cuid())
  taskId        String
  voterUserId   String
  progressCount Int                 @default(0)
  claimedAt     DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  task          VoterEngagementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  voterUser     User                @relation(fields: [voterUserId], references: [id], onDelete: Cascade)

  @@unique([taskId, voterUserId])
  @@index([voterUserId])
}

model AdminCandidateAssignment {
  id              String                   @id @default(cuid())
  adminUserId     String
  candidateUserId String
  candidateId     String?
  permissionType  AssignmentPermissionType
  createdAt       DateTime                 @default(now())
  adminUser       User                     @relation("AssignmentAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  candidateUser   User                     @relation("AssignmentCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  candidate       Candidate?               @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@unique([adminUserId, candidateUserId, permissionType])
  @@index([candidateUserId])
  @@index([candidateId])
  @@index([permissionType])
}

model RewardLedger {
  id            String     @id @default(cuid())
  voterUserId   String
  type          RewardType
  points        Int
  amount        Float?
  description   String
  relatedUserId String?
  createdAt     DateTime   @default(now())
  voterUser     User       @relation("RewardOwner", fields: [voterUserId], references: [id], onDelete: Cascade)
  relatedUser   User?      @relation("RewardRelatedUser", fields: [relatedUserId], references: [id])

  @@unique([voterUserId, type, relatedUserId])
  @@index([voterUserId, createdAt])
  @@index([type])
}

model VoterVerification {
  id                 String                       @id @default(cuid())
  memberUserId       String                       @unique
  voterIdentifier    String
  status             VoterVerificationStatus      @default(NOT_SUBMITTED)
  isFlagged          Boolean                      @default(false)
  fraudReason        String?
  submittedAt        DateTime?
  reviewStartedAt    DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  reviewNote         String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  memberUser         User                         @relation("VoterVerificationMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  reviewedByUser     User?                        @relation("VoterVerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  documents          VoterVerificationDocument[]
  history            VoterVerificationHistory[]

  @@index([status, submittedAt])
  @@index([reviewedByUserId])
  @@index([voterIdentifier])
  @@index([isFlagged])
}

model VoterVerificationDocument {
  id                 String             @id @default(cuid())
  verificationId     String
  originalStorageKey String             @unique
  previewStorageKey  String?
  originalFileName   String
  mimeType           String
  fileSize           Int
  sha256             String
  storageProvider    String
  uploadedAt         DateTime           @default(now())
  verification       VoterVerification  @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
  @@index([sha256])
  @@index([uploadedAt])
}

model VoterVerificationHistory {
  id                 String                    @id @default(cuid())
  verificationId     String
  actorUserId        String?
  fromStatus         VoterVerificationStatus?
  toStatus           VoterVerificationStatus
  decision           VoterVerificationDecision
  note               String?
  metadataJson       Json?
  createdAt          DateTime                  @default(now())
  verification       VoterVerification         @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  actorUser          User?                      @relation("VoterVerificationHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([verificationId, createdAt])
  @@index([actorUserId])
  @@index([decision])
}

model ReferralCode {
  id          String   @id @default(cuid())
  ownerUserId String
  code        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerUser   User     @relation("ReferralCodeOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  referrals   Referral[]

  @@index([ownerUserId])
  @@index([isActive])
}

model Referral {
  id                String           @id @default(cuid())
  referredUserId    String           @unique
  referrerUserId    String
  referralCodeId    String?
  referralCode      String
  status            ReferralStatus   @default(REGISTERED)
  registeredAt      DateTime         @default(now())
  qualifiedAt       DateTime?
  rewardProcessedAt DateTime?
  flaggedAt         DateTime?
  fraudReason       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  referredUser      User             @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrerUser      User             @relation("ReferralReferrerUser", fields: [referrerUserId], references: [id], onDelete: Restrict)
  referralCodeOwner ReferralCode?    @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  rewardEvents      RewardEvent[]

  @@unique([referrerUserId, referredUserId])
  @@index([referrerUserId])
  @@index([status])
  @@index([registeredAt])
}

model RewardRule {
