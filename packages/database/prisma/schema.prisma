model ElectionDayReport {
  id                    String                    @id @default(cuid())
  agentUserId           String
  reviewedByUserId      String?
  reportDate            DateTime
  status                ElectionDayReportStatus  @default(SUBMITTED)
  openingStatus         ElectionDayOpeningStatus
  arrivalConfirmedAt    DateTime
  turnoutObservation    String
  incidentNotes         String?
  remarks               String?
  reviewNote            String?
  voteEntriesJson       Json
  arrivalPhotoAssetId   String                    @unique
  postCountingPhotoAssetId String                 @unique
  geoPoliticalZoneId    String?
  stateId               String
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String
  wardId                String
  stateConstituencyId   String?
  pollingUnitId         String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  reviewedAt            DateTime?
  agentUser             User                      @relation("ElectionDayReportAgent", fields: [agentUserId], references: [id], onDelete: Cascade)
  reviewedByUser        User?                     @relation("ElectionDayReportReviewer", fields: [reviewedByUserId], references: [id])
  arrivalPhotoAsset     ElectionDayReportAsset    @relation("ElectionDayReportArrivalPhoto", fields: [arrivalPhotoAssetId], references: [id], onDelete: Restrict)
  postCountingPhotoAsset ElectionDayReportAsset   @relation("ElectionDayReportPostCountingPhoto", fields: [postCountingPhotoAssetId], references: [id], onDelete: Restrict)
  geoPoliticalZone      GeoPoliticalZone?         @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State                     @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?       @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency?      @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA                       @relation(fields: [lgaId], references: [id])
  ward                  Ward                      @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?        @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit               @relation(fields: [pollingUnitId], references: [id])

  @@unique([agentUserId, pollingUnitId, reportDate])
  @@index([status])
  @@index([agentUserId])
  @@index([reviewedByUserId])
  @@index([reportDate])
  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
  @@index([createdAt])
}

model MediaAttachment {
