generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CANDIDATE
  AGENT
  VOTER
}

enum AdminLevel {
  NATIONAL
  GEO_POLITICAL_ZONE
  STATE
  SENATORIAL
  FEDERAL_CONSTITUENCY
  STATE_CONSTITUENCY
  LGA
  WARD
}

enum CandidateOfficeType {
  PRESIDENTIAL
  GOVERNORSHIP
  SENATE
  HOUSE_OF_REP
  STATE_ASSEMBLY
  CHAIRMANSHIP
  COUNCILLOR
}

enum RewardType {
  PARTICIPATION
  REFERRAL
  BONUS
  MANUAL_ADJUSTMENT
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum AssignmentPermissionType {
  VIEW
  MANAGE
  PUBLISH
  MODERATE
}

enum AgentActivityType {
  CHECK_IN
  CHECK_OUT
  LOCATION_PING
  INCIDENT_RESPONSE
  VOTER_OUTREACH
  MATERIAL_DISTRIBUTION
  OBSERVATION
}

enum IncidentType {
  VIOLENCE
  INTIMIDATION
  VOTE_BUYING
  MATERIAL_SHORTAGE
  LOGISTICS_DELAY
  MALFUNCTION
  SECURITY_CONCERN
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  REWARD_EARNED
  REWARD_REDEMPTION
  INCIDENT_ASSIGNED
  INCIDENT_UPDATED
  POLL_CREATED
  POST_PUBLISHED
  SYSTEM
}

enum FieldTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum FieldTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BroadcastAudience {
  ALL
  ADMINS
  AGENTS
  VOTERS
  CANDIDATES
}

enum CampaignMediaType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id                     String                     @id @default(cuid())
  name                   String
  email                  String                     @unique
  phone                  String?
  passwordHash           String
  role                   UserRole
  isActive               Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  adminProfile           AdminProfile?
  candidateProfile       CandidateProfile?
  agentProfile           AgentProfile?
  voterProfile           VoterProfile?
  managedCandidateLinks  AdminCandidateAssignment[] @relation("AssignmentAdmin")
  assignedAdminLinks     AdminCandidateAssignment[] @relation("AssignmentCandidate")
  rewardEntries          RewardLedger[]             @relation("RewardOwner")
  rewardRelatedEntries   RewardLedger[]             @relation("RewardRelatedUser")
  rewardRedemptions      RewardRedemption[]         @relation("RewardRedemptionVoter")
  reviewedRedemptions    RewardRedemption[]         @relation("RewardRedemptionReviewer")
  referralsMade          VoterProfile[]             @relation("VoterReferral")
  assignedAgents         AgentProfile[]             @relation("AssignedAdmin")
  participationEvents    ParticipationEvent[]
  createdPolls           Poll[]                     @relation("PollCreator")
  candidatePolls         Poll[]                     @relation("PollCandidate")
  pollResponses          PollResponse[]
  authoredPosts          Post[]                     @relation("PostAuthor")
  candidatePosts         Post[]                     @relation("PostCandidate")
  voterFeedbackItems     Feedback[]                 @relation("FeedbackVoter")
  agentFeedbackItems     Feedback[]                 @relation("FeedbackAgent")
  candidateFeedbackItems Feedback[]                 @relation("FeedbackCandidate")
  agentActivities        AgentActivity[]
  reportedIncidents      Incident[]                 @relation("IncidentReporter")
  assignedIncidents      Incident[]                 @relation("IncidentAssignedAdmin")
  escalatedIncidents     Incident[]                 @relation("IncidentEscalatedBy")
  assignedTasks          FieldTask[]                @relation("FieldTaskAssignee")
  createdTasks           FieldTask[]                @relation("FieldTaskCreator")
  createdBroadcasts      BroadcastMessage[]         @relation("BroadcastCreator")
  notifications          Notification[]
  auditLogs              AuditLog[]
  mediaAttachments       MediaAttachment[]          @relation("MediaUploader")
  createdEngagementTasks VoterEngagementTask[]      @relation("EngagementTaskCreator")
  engagementTaskClaims   VoterEngagementClaim[]

  @@index([role])
  @@index([isActive])
}

model AdminProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  adminLevel            AdminLevel
  geoPoliticalZoneId    String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])

  @@index([adminLevel])
  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model CandidateProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  officeType            CandidateOfficeType
  geoPoliticalZoneId    String?
  politicalPartyId      String?
  portraitUrl           String?
  campaignSlogan        String?
  bio                   String?
  websiteUrl            String?
  facebookUrl           String?
  instagramUrl          String?
  xUrl                  String?
  isProfilePublished    Boolean              @default(false)
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  politicalParty        PoliticalParty?      @relation(fields: [politicalPartyId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])

  @@index([officeType])
  @@index([geoPoliticalZoneId])
  @@index([politicalPartyId])
  @@index([isProfilePublished])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model AgentProfile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  assignedAdminUserId String?
  geoPoliticalZoneId  String?
  stateId             String
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId               String
  wardId              String
  stateConstituencyId String?
  pollingUnitId       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAdminUser   User?        @relation("AssignedAdmin", fields: [assignedAdminUserId], references: [id])
  geoPoliticalZone    GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state               State        @relation(fields: [stateId], references: [id])
  senatorialDistrict  SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                 LGA          @relation(fields: [lgaId], references: [id])
  ward                Ward         @relation(fields: [wardId], references: [id])
  stateConstituency   StateConstituency? @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit         PollingUnit? @relation(fields: [pollingUnitId], references: [id])

  @@index([geoPoliticalZoneId])
  @@index([assignedAdminUserId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model VoterProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  voterCardNumber  String   @unique
  referralCode     String   @unique
  referredByUserId String?
  contactConsent   Boolean  @default(false)
  termsAcceptedAt  DateTime?
  geoPoliticalZoneId String?
  stateId          String
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId            String
  wardId           String
  stateConstituencyId String?
  pollingUnitId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredByUser   User?    @relation("VoterReferral", fields: [referredByUserId], references: [id])
  geoPoliticalZone GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state            State    @relation(fields: [stateId], references: [id])
  senatorialDistrict SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga              LGA      @relation(fields: [lgaId], references: [id])
  ward             Ward     @relation(fields: [wardId], references: [id])
  stateConstituency StateConstituency? @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit      PollingUnit? @relation(fields: [pollingUnitId], references: [id])

  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
  @@index([referredByUserId])
}

model VoterEngagementTask {
  id                   String                 @id @default(cuid())
  title                String
  description          String
  type                 String
  rewardPoints         Int
  targetCount          Int?
  isActive             Boolean                @default(true)
  createdByUserId      String
  geoPoliticalZoneId   String?
  stateId              String?
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId                String?
  wardId               String?
  stateConstituencyId  String?
  pollingUnitId        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdByUser        User                   @relation("EngagementTaskCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone     GeoPoliticalZone?      @relation(fields: [geoPoliticalZoneId], references: [id])
  state                State?                 @relation(fields: [stateId], references: [id])
  senatorialDistrict   SenatorialDistrict?    @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency  FederalConstituency?   @relation(fields: [federalConstituencyId], references: [id])
  lga                  LGA?                   @relation(fields: [lgaId], references: [id])
  ward                 Ward?                  @relation(fields: [wardId], references: [id])
  stateConstituency    StateConstituency?     @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit          PollingUnit?           @relation(fields: [pollingUnitId], references: [id])
  claims               VoterEngagementClaim[]

  @@index([createdByUserId])
  @@index([isActive])
  @@index([geoPoliticalZoneId])
  @@index([stateId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
}

model VoterEngagementClaim {
  id               String              @id @default(cuid())
  taskId           String
  voterUserId      String
  progressCount    Int                 @default(0)
  claimedAt        DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  task             VoterEngagementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  voterUser        User                @relation(fields: [voterUserId], references: [id], onDelete: Cascade)

  @@unique([taskId, voterUserId])
  @@index([voterUserId])
}

model AdminCandidateAssignment {
  id              String                   @id @default(cuid())
  adminUserId     String
  candidateUserId String
  permissionType  AssignmentPermissionType
  createdAt       DateTime                 @default(now())
  adminUser       User                     @relation("AssignmentAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  candidateUser   User                     @relation("AssignmentCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, candidateUserId, permissionType])
  @@index([candidateUserId])
  @@index([permissionType])
}

model RewardLedger {
  id            String   @id @default(cuid())
  voterUserId   String
  type          RewardType
  points        Int
  amount        Float?
  description   String
  relatedUserId String?
  createdAt     DateTime @default(now())
  voterUser     User     @relation("RewardOwner", fields: [voterUserId], references: [id], onDelete: Cascade)
  relatedUser   User?    @relation("RewardRelatedUser", fields: [relatedUserId], references: [id])

  @@index([voterUserId, createdAt])
  @@index([type])
  @@unique([voterUserId, type, relatedUserId])
}

model ParticipationEvent {
  id           String   @id @default(cuid())
  voterUserId   String
  type          String
  description   String
  pointsAwarded Int
  relatedPollId String?
  relatedPostId String?
  createdAt     DateTime @default(now())
  voterUser     User     @relation(fields: [voterUserId], references: [id], onDelete: Cascade)
  relatedPoll   Poll?    @relation(fields: [relatedPollId], references: [id])
  relatedPost   Post?    @relation(fields: [relatedPostId], references: [id])

  @@index([voterUserId, createdAt])
  @@index([type])
  @@index([relatedPollId])
  @@index([relatedPostId])
}

model Poll {
  id                    String               @id @default(cuid())
  title                 String
  description           String?
  candidateUserId       String?
  officeType            CandidateOfficeType?
  geoPoliticalZoneId    String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  createdByUserId       String
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  candidateUser         User?                @relation("PollCandidate", fields: [candidateUserId], references: [id])
  createdByUser         User                 @relation("PollCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])
  options               PollOption[]
  responses             PollResponse[]
  participationEvents   ParticipationEvent[]

  @@index([geoPoliticalZoneId])
  @@index([candidateUserId])
  @@index([officeType])
  @@index([isActive])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model PollOption {
  id        String   @id @default(cuid())
  pollId     String
  label      String
  createdAt  DateTime @default(now())
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses  PollResponse[]

  @@unique([pollId, label])
  @@index([pollId])
}

model PollResponse {
  id          String     @id @default(cuid())
  pollId      String
  voterUserId String
  optionId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voterUser   User       @relation(fields: [voterUserId], references: [id], onDelete: Cascade)
  option      PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterUserId])
  @@index([optionId])
}

model Post {
  id                    String               @id @default(cuid())
  authorUserId          String
  candidateUserId       String?
  geoPoliticalZoneId    String?
  title                 String
  content               String
  mediaType             CampaignMediaType    @default(TEXT)
  mediaUrl              String?
  thumbnailUrl          String?
  stateId               String?
  senatorialDistrictId  String?
  federalConstituencyId String?
  lgaId                 String?
  wardId                String?
  stateConstituencyId   String?
  pollingUnitId         String?
  isPublished           Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  authorUser            User                 @relation("PostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  candidateUser         User?                @relation("PostCandidate", fields: [candidateUserId], references: [id])
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                 State?               @relation(fields: [stateId], references: [id])
  senatorialDistrict    SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency   FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                   LGA?                 @relation(fields: [lgaId], references: [id])
  ward                  Ward?                @relation(fields: [wardId], references: [id])
  stateConstituency     StateConstituency?   @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit           PollingUnit?         @relation(fields: [pollingUnitId], references: [id])
  participationEvents   ParticipationEvent[]

  @@index([geoPoliticalZoneId])
  @@index([authorUserId])
  @@index([candidateUserId])
  @@index([isPublished])
  @@index([mediaType])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([federalConstituencyId])
  @@index([lgaId])
  @@index([wardId])
  @@index([stateConstituencyId])
  @@index([pollingUnitId])
}

model Feedback {
  id                   String               @id @default(cuid())
  voterUserId          String?
  agentUserId          String?
  candidateUserId      String?
  type                 String
  message              String
  geoPoliticalZoneId   String?
  stateId              String
  senatorialDistrictId String?
  lgaId                String
  wardId               String?
  pollingUnitId        String?
  createdAt            DateTime             @default(now())
  voterUser            User?                @relation("FeedbackVoter", fields: [voterUserId], references: [id])
  agentUser            User?                @relation("FeedbackAgent", fields: [agentUserId], references: [id])
  candidateUser        User?                @relation("FeedbackCandidate", fields: [candidateUserId], references: [id])
  geoPoliticalZone     GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id])
  state                State                @relation(fields: [stateId], references: [id])
  senatorialDistrict   SenatorialDistrict?  @relation(fields: [senatorialDistrictId], references: [id])
  lga                  LGA                  @relation(fields: [lgaId], references: [id])
  ward                 Ward?                @relation(fields: [wardId], references: [id])
  pollingUnit          PollingUnit?         @relation(fields: [pollingUnitId], references: [id])
  mediaAttachments     MediaAttachment[]

  @@index([geoPoliticalZoneId])
  @@index([voterUserId])
  @@index([agentUserId])
  @@index([candidateUserId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
  @@index([createdAt])
}

model AgentActivity {
  id             String            @id @default(cuid())
  agentUserId    String
  type           AgentActivityType
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  note           String?
  geoPoliticalZoneId String?
  stateId        String
  lgaId          String
  wardId         String
  pollingUnitId  String?
  createdAt      DateTime          @default(now())
  agentUser      User              @relation(fields: [agentUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state          State             @relation(fields: [stateId], references: [id])
  lga            LGA               @relation(fields: [lgaId], references: [id])
  ward           Ward              @relation(fields: [wardId], references: [id])
  pollingUnit    PollingUnit?      @relation(fields: [pollingUnitId], references: [id])

  @@index([geoPoliticalZoneId])
  @@index([agentUserId])
  @@index([pollingUnitId])
  @@index([createdAt])
  @@index([type])
}

model Incident {
  id             String    @id @default(cuid())
  reportedByUserId String
  type           IncidentType
  title          String
  description    String
  severity       IncidentSeverity
  status         IncidentStatus
  latitude       Float?
  longitude      Float?
  geoPoliticalZoneId String?
  stateId        String
  senatorialDistrictId String?
  lgaId          String
  wardId         String?
  pollingUnitId  String?
  assignedAdminUserId String?
  escalatedAt       DateTime?
  escalatedByUserId String?
  escalationNote    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reportedByUser User      @relation("IncidentReporter", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state          State     @relation(fields: [stateId], references: [id])
  senatorialDistrict SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  lga            LGA       @relation(fields: [lgaId], references: [id])
  ward           Ward?     @relation(fields: [wardId], references: [id])
  pollingUnit    PollingUnit? @relation(fields: [pollingUnitId], references: [id])
  assignedAdminUser User?  @relation("IncidentAssignedAdmin", fields: [assignedAdminUserId], references: [id])
  escalatedByUser User? @relation("IncidentEscalatedBy", fields: [escalatedByUserId], references: [id])
  tasks            FieldTask[]
  mediaAttachments MediaAttachment[]

  @@index([geoPoliticalZoneId])
  @@index([reportedByUserId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
  @@index([assignedAdminUserId])
  @@index([escalatedByUserId])
  @@index([createdAt])
}

model FieldTask {
  id                   String            @id @default(cuid())
  title                String
  description          String
  status               FieldTaskStatus   @default(TODO)
  priority             FieldTaskPriority @default(MEDIUM)
  createdByUserId      String
  assignedToUserId     String
  incidentId           String?
  dueAt                DateTime?
  completedAt          DateTime?
  resolutionNote       String?
  geoPoliticalZoneId   String?
  stateId              String
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId                String
  wardId               String
  stateConstituencyId  String?
  pollingUnitId        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdByUser        User              @relation("FieldTaskCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedToUser       User              @relation("FieldTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  incident             Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  geoPoliticalZone     GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state                State             @relation(fields: [stateId], references: [id])
  senatorialDistrict   SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency  FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                  LGA               @relation(fields: [lgaId], references: [id])
  ward                 Ward              @relation(fields: [wardId], references: [id])
  stateConstituency    StateConstituency? @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit          PollingUnit?      @relation(fields: [pollingUnitId], references: [id])

  @@index([assignedToUserId, status])
  @@index([createdByUserId, createdAt])
  @@index([incidentId])
  @@index([stateId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
  @@index([priority])
  @@index([dueAt])
}

model BroadcastMessage {
  id                   String            @id @default(cuid())
  title                String
  message              String
  audience             BroadcastAudience
  taskStatus           FieldTaskStatus?
  createdByUserId      String
  recipientCount       Int               @default(0)
  geoPoliticalZoneId   String?
  stateId              String?
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId                String?
  wardId               String?
  stateConstituencyId  String?
  pollingUnitId        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdByUser        User              @relation("BroadcastCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone     GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state                State?            @relation(fields: [stateId], references: [id])
  senatorialDistrict   SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency  FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                  LGA?              @relation(fields: [lgaId], references: [id])
  ward                 Ward?             @relation(fields: [wardId], references: [id])
  stateConstituency    StateConstituency? @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit          PollingUnit?      @relation(fields: [pollingUnitId], references: [id])

  @@index([audience, createdAt])
  @@index([taskStatus])
  @@index([stateId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
}

model RewardRedemption {
  id               String                 @id @default(cuid())
  voterUserId      String
  pointsRequested  Int
  amountRequested  Float?
  status           RewardRedemptionStatus
  note             String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  voterUser        User                   @relation("RewardRedemptionVoter", fields: [voterUserId], references: [id], onDelete: Cascade)
  reviewedByUser   User?                  @relation("RewardRedemptionReviewer", fields: [reviewedByUserId], references: [id])

  @@index([voterUserId])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  action       String
  targetType   String
  targetId     String
  metadataJson String?
  createdAt    DateTime @default(now())
  actorUser    User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model MediaAttachment {
  id             String    @id @default(cuid())
  uploaderUserId String
  incidentId     String?
  feedbackId     String?
  fileName       String
  mimeType       String
  fileUrl        String
  createdAt      DateTime  @default(now())
  uploaderUser   User      @relation("MediaUploader", fields: [uploaderUserId], references: [id], onDelete: Cascade)
  incident       Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  feedback       Feedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  @@index([uploaderUserId])
  @@index([incidentId])
  @@index([feedbackId])
  @@index([createdAt])
}

model GeoPoliticalZone {
  id                 String             @id
  name               String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  states             State[]
  adminProfiles      AdminProfile[]
  candidateProfiles  CandidateProfile[]
  agentProfiles      AgentProfile[]
  voterProfiles      VoterProfile[]
  polls              Poll[]
  posts              Post[]
  feedbackItems      Feedback[]
  agentActivities    AgentActivity[]
  incidents          Incident[]
  fieldTasks         FieldTask[]
  broadcastMessages  BroadcastMessage[]
  voterEngagementTasks VoterEngagementTask[]
}

model PoliticalParty {
  id                 String             @id
  name               String             @unique
  code               String             @unique
  logoUrl            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  candidateProfiles  CandidateProfile[]
}

model State {
  id                    String               @id
  name                  String               @unique
  geoPoliticalZoneId    String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  geoPoliticalZone      GeoPoliticalZone?    @relation(fields: [geoPoliticalZoneId], references: [id], onDelete: Cascade)
  senatorialDistricts   SenatorialDistrict[]
  federalConstituencies FederalConstituency[]
  stateConstituencies   StateConstituency[]
  lgas                  LGA[]
  wards                 Ward[]
  pollingUnits          PollingUnit[]
  adminProfiles         AdminProfile[]
  candidateProfiles     CandidateProfile[]
  agentProfiles         AgentProfile[]
  voterProfiles         VoterProfile[]
  polls                 Poll[]
  posts                 Post[]
  feedbackItems         Feedback[]
  agentActivities       AgentActivity[]
  incidents             Incident[]
  fieldTasks            FieldTask[]
  broadcastMessages     BroadcastMessage[]
  voterEngagementTasks  VoterEngagementTask[]
  @@index([geoPoliticalZoneId])
}

model SenatorialDistrict {
  id                    String               @id
  name                  String
  stateId               String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  state                 State                @relation(fields: [stateId], references: [id], onDelete: Cascade)
