  name               String
  qualifyingEvent    RewardQualifyingEvent
  eligibleRole       UserRole
  eligibleCoordinatorLevel CoordinatorLevel?
  active             Boolean                @default(true)
  effectiveFrom      DateTime               @default(now())
  effectiveUntil     DateTime?
