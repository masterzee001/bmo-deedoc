  @@index([geoPoliticalZoneId])
  @@index([voterUserId])
  @@index([agentUserId])
  @@index([candidateUserId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
  @@index([createdAt])
}

model AgentActivity {
  id             String            @id @default(cuid())
  agentUserId    String
  type           AgentActivityType
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  note           String?
  geoPoliticalZoneId String?
  stateId        String
  lgaId          String
  wardId         String
  pollingUnitId  String?
  createdAt      DateTime          @default(now())
  agentUser      User              @relation(fields: [agentUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state          State             @relation(fields: [stateId], references: [id])
  lga            LGA               @relation(fields: [lgaId], references: [id])
  ward           Ward              @relation(fields: [wardId], references: [id])
  pollingUnit    PollingUnit?      @relation(fields: [pollingUnitId], references: [id])

  @@index([geoPoliticalZoneId])
  @@index([agentUserId])
  @@index([pollingUnitId])
  @@index([createdAt])
  @@index([type])
}

model Incident {
  id             String    @id @default(cuid())
  reportedByUserId String
  type           IncidentType
  title          String
  description    String
  severity       IncidentSeverity
  status         IncidentStatus
  latitude       Float?
  longitude      Float?
  geoPoliticalZoneId String?
  stateId        String
  senatorialDistrictId String?
  lgaId          String
  wardId         String?
  pollingUnitId  String?
  assignedAdminUserId String?
  escalatedAt       DateTime?
  escalatedByUserId String?
  escalationNote    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reportedByUser User      @relation("IncidentReporter", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  geoPoliticalZone GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state          State     @relation(fields: [stateId], references: [id])
  senatorialDistrict SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  lga            LGA       @relation(fields: [lgaId], references: [id])
  ward           Ward?     @relation(fields: [wardId], references: [id])
  pollingUnit    PollingUnit? @relation(fields: [pollingUnitId], references: [id])
  assignedAdminUser User?  @relation("IncidentAssignedAdmin", fields: [assignedAdminUserId], references: [id])
  escalatedByUser User? @relation("IncidentEscalatedBy", fields: [escalatedByUserId], references: [id])
  tasks            FieldTask[]
  mediaAttachments MediaAttachment[]

  @@index([geoPoliticalZoneId])
  @@index([reportedByUserId])
  @@index([stateId])
  @@index([senatorialDistrictId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
  @@index([assignedAdminUserId])
  @@index([escalatedByUserId])
  @@index([createdAt])
}

model FieldTask {
  id                   String            @id @default(cuid())
  title                String
  description          String
  status               FieldTaskStatus   @default(TODO)
  priority             FieldTaskPriority @default(MEDIUM)
  createdByUserId      String
  assignedToUserId     String
  incidentId           String?
  dueAt                DateTime?
  completedAt          DateTime?
  resolutionNote       String?
  geoPoliticalZoneId   String?
  stateId              String
  senatorialDistrictId String?
  federalConstituencyId String?
  lgaId                String
  wardId               String
  stateConstituencyId  String?
  pollingUnitId        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdByUser        User              @relation("FieldTaskCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedToUser       User              @relation("FieldTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  incident             Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  geoPoliticalZone     GeoPoliticalZone? @relation(fields: [geoPoliticalZoneId], references: [id])
  state                State             @relation(fields: [stateId], references: [id])
  senatorialDistrict   SenatorialDistrict? @relation(fields: [senatorialDistrictId], references: [id])
  federalConstituency  FederalConstituency? @relation(fields: [federalConstituencyId], references: [id])
  lga                  LGA               @relation(fields: [lgaId], references: [id])
  ward                 Ward              @relation(fields: [wardId], references: [id])
  stateConstituency    StateConstituency? @relation(fields: [stateConstituencyId], references: [id])
  pollingUnit          PollingUnit?      @relation(fields: [pollingUnitId], references: [id])

  @@index([assignedToUserId, status])
  @@index([createdByUserId, createdAt])
  @@index([incidentId])
  @@index([stateId])
  @@index([lgaId])
  @@index([wardId])
  @@index([pollingUnitId])
  @@index([priority])
  @@index([dueAt])
}

