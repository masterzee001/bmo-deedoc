{
  "name": "@pics-nigeria/database",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma --name init",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma --accept-data-loss",
    "prisma:push:reset": "prisma db push --schema prisma/schema.prisma --accept-data-loss --force-reset",
    "seed": "tsx prisma/seed.ts",
    "seed:credentials": "tsx scripts/print-seeded-credentials.ts",
    "bootstrap:check": "tsx scripts/check-bootstrap.ts"
  },
  "dependencies": {
    "@pics-nigeria/shared": "1.0.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3"
  }
}
